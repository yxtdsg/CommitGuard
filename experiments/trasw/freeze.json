      0.406
    ],
    "repeats": "r1/r2/r3 \u5171\u4eab\u540c\u4e00\u51bb\u7ed3\u5bf9\u6297\u5e27\u96c6\uff0c\u5747\u4e3a\u91cd\u590d\u6807\u7b7e\uff1b\u4e0d\u6784\u9020\u65b0\u653b\u51fb\u6837\u672c\u6216\u65b0\u968f\u673a\u79cd\u5b50\uff1br1/r2 \u662f\u9884\u6ce8\u518c\u786e\u5b9a\u6027\u6bd4\u8f83",
    "std": [
      0.229,
      0.224,
      0.225
    ],
    "storage": "\u5408\u6210\u540e cast float16\uff0c\u518d\u65e0\u635f cast float32 \u4fdd\u5b58\uff1bclean \u5f20\u91cf\u540c\u6837\u6765\u81ea\u5b9e\u9645 fp16 \u8f93\u5165\uff1b\u4fdd\u5b58\u5168\u90e8 300 clean+300 attack \u5e27",
    "targets": "\u8be5\u5e27\u6240\u6709\u5df2\u5bfc\u51fa candidate\uff0c\u4e0d\u6309 suc\u3001\u7ed3\u679c\u3001\u5e27\u6216\u653b\u51fb\u6548\u679c\u7b5b\u9009\uff1b\u65e0 candidate \u7b49\u4ef7\u4e8e\u65e0 delta"
