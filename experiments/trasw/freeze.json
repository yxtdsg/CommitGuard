  "attack_generation": {
    "algorithm": "\u539f TraSA update_attack_sg/ifgsm_adam_sg \u539f\u6837\u6267\u884c\uff1b\u4fdd\u7559 X5 clone ID/frame-counter \u7f3a\u9677",
