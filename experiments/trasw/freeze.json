    "export": "\u5b9e\u9645\u5f52\u4e00\u5316 fp16 imgs[0]\uff1bcandidate \u4f4d\u4e8e\u6700\u7ec8\u9010\u901a\u9053 clamp \u540e\u3001recoverNoise \u548c clone update \u524d\uff1bnoise=None \u4e5f\u5bfc\u51fa clean candidate\uff1b\u7981\u6b62\u53ef\u89c6\u5316\u843d\u76d8",
    "one_attempt_per_segment": true
  },
  "composition": {
    "clip": "\u4ec5\u6700\u7ec8\u4e00\u6b21 per-channel normalized clip: low=-mean/std, high=(1-mean)/std",
    "formula": "float64(clean)+sum_{target_id ascending}[float64(candidate)-float64(clean)]",
    "mean": [
      0.485,
